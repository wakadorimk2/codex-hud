<Window x:Class="CodexHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:CodexHud.Rendering"
        Width="36"
        Height="36"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None">
    <Border x:Name="EditFrame"
            BorderBrush="#FFF4F7FF"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="Collapsed">
        <rendering:SkiaLampView x:Name="LampSurface"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
    </Border>
</Window>
