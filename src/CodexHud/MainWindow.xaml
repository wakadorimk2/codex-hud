<Window x:Class="CodexHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1"
        Height="1"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="None">
    <Grid>
        <Border x:Name="LampGroupSurface"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <WrapPanel x:Name="LampPanel"
                       Orientation="Horizontal"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
        </Border>
        <Border x:Name="EditFrame"
                Panel.ZIndex="1"
                Background="Transparent"
                BorderBrush="#FFF4F7FF"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed" />
    </Grid>
</Window>
